# SignBridge animation service -- configuration example.
# Copy to .env for local use. Never commit real secrets.

# Root of the original SignBridge engine (main.py, animation_lib.py, Pose/).
# Inside the container this is /app.
SIGNBRIDGE_ROOT=/app

# Directory for generated MP4s. Files are deleted after each response; this
# directory only needs to be writable and outside the repository.
OUTPUT_DIR=/tmp/signbridge-outputs

# Never open a GUI window (required in containers / on Render).
SIGNBRIDGE_HEADLESS=1

# Shared secret required by POST /v1/animations and
# POST /v1/animations/structured. Send it as `X-API-Key: <key>` (or
# `Authorization: Bearer <key>`). The service refuses POSTs when this is unset.
SIGNBRIDGE_API_KEY=change-me-to-a-long-random-string

# Request safety limits.
MAX_TEXT_LENGTH=280
MAX_REQUEST_SIZE=65536

# ffmpeg / ffprobe executables (defaults resolve from PATH).
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# FFMPEG_TIMEOUT_SEC=180

# Delete leftover MP4s older than this on startup (seconds).
# OUTPUT_RETENTION_SEC=86400

# Port used by the container command (Render may inject its own PORT).
PORT=8000

# Logging
LOG_LEVEL=info

# Optional: spaCy model name used by gloss generation.
# SIGNBRIDGE_SPACY_MODEL=en_core_web_sm
